{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:result.v1",
  "title": "Prescription result (Output Contract, result.v1)",
  "description": "One document per prescription (backlog UP-S3, OUT-S2): shown by the upload screen, served by GET /api/documents/{id}/result.json and written as a file. Every clinical value is a {value, status, confidence, evidence} object: a value never appears without its status, 'accepted' requires both a governed gate state and recorded evidence, and 'needs_check' always says why. STRICT: a field this schema does not name is rejected, at every level; categories are fixed lists; unknown is null. The field names are the Output Contract's own and are provisional until OUT-S2's open question (which system reads the JSON) is answered; 'schema_version' is what a consumer pins.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "received_at",
    "source",
    "page_count",
    "status",
    "review",
    "absent"
  ],
  "properties": {
    "schema_version": {
      "const": "result.v1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "page_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "complete",
        "needs_check",
        "incomplete",
        "refusal",
        "held_for_rescan"
      ],
      "description": "complete: every value shown is accepted. needs_check: at least one value waits for a person. incomplete: the model's answer was cut short or did not fit its format; what was read is here, all of it held. refusal: the model declined to read the document; there is no answer. held_for_rescan: the document could not be read."
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string"
            },
            "drive": {
              "type": [
                "string",
                "null"
              ]
            },
            "folder": {
              "type": [
                "string",
                "null"
              ]
            },
            "file_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "also_received": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string"
                  },
                  "drive": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "folder": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "file_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "patient": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/value"
        },
        "sex": {
          "$ref": "#/$defs/value"
        },
        "dob": {
          "$ref": "#/$defs/value"
        },
        "age_text": {
          "$ref": "#/$defs/value"
        },
        "phone": {
          "$ref": "#/$defs/value"
        },
        "address": {
          "$ref": "#/$defs/value"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "mpi_id",
                  "mrn",
                  "abha"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "ids_read": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value",
              "status",
              "confidence"
            ],
            "properties": {
              "type": {
                "enum": [
                  "mrn",
                  "abha"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "accepted",
                  "needs_check"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              },
              "corrected_from": {
                "type": "object",
                "required": [
                  "fact_id",
                  "value",
                  "observation_ids"
                ],
                "properties": {
                  "fact_id": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "observation_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "description": "Present when a person corrected the value: the reading it replaced."
              }
            },
            "additionalProperties": false,
            "if": {
              "properties": {
                "status": {
                  "const": "needs_check"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "doctor": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/value"
        },
        "registration_no": {
          "$ref": "#/$defs/value"
        },
        "qualification": {
          "$ref": "#/$defs/value"
        },
        "department": {
          "$ref": "#/$defs/value"
        },
        "clinic": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/value"
            },
            "address": {
              "$ref": "#/$defs/value"
            },
            "phone": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false
        },
        "stamp_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signature_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stamp_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "registration_number",
                "name",
                "unknown"
              ]
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "practitioner_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "practitioner_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "type": [
                "string",
                "null"
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "practitioner_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "registration_no": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "council": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "department": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "why": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "visit": {
      "type": "object",
      "properties": {
        "encounter_date": {
          "$ref": "#/$defs/value"
        },
        "follow_up": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "additionalProperties": false
    },
    "lab_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "as_written",
          "value"
        ],
        "properties": {
          "as_written": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "test",
              "panel",
              "study",
              null
            ]
          },
          "specimen": {
            "type": [
              "string",
              "null"
            ]
          },
          "urgency": {
            "enum": [
              "urgent",
              null
            ]
          },
          "standard": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "code_system": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "match": {
            "enum": [
              "matched",
              "doubtful",
              "not_matched"
            ]
          },
          "matched_by": {
            "enum": [
              "exact",
              "alias",
              "normalised",
              "fuzzy",
              "chosen",
              null
            ]
          },
          "value": {
            "$ref": "#/$defs/value"
          },
          "result": {
            "$ref": "#/$defs/value"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "internal_id": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "code_system": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "test",
                    "panel",
                    "study"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "preparation_refs": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "context": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "text",
                "relation",
                "quote"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "diagnosis",
                    "complaint",
                    "note"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "relation": {
                  "enum": [
                    "same_line",
                    "same_page",
                    "other_page"
                  ]
                },
                "quote": {
                  "type": "string"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                },
                "fits": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "check": {
            "const": "check: does not fit"
          }
        },
        "additionalProperties": false
      }
    },
    "lab_master_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "raw_text",
          "value"
        ],
        "properties": {
          "raw_text": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "canonical_term": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "$ref": "#/$defs/value"
          },
          "external_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "system",
                "code"
              ],
              "properties": {
                "system": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "preparation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "status",
          "confidence",
          "text",
          "instruction"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "status": {
            "enum": [
              "accepted",
              "needs_check"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "corrected_from": {
            "type": "object",
            "required": [
              "fact_id",
              "value",
              "observation_ids"
            ],
            "properties": {
              "fact_id": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "observation_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false,
            "description": "Present when a person corrected the value: the reading it replaced."
          },
          "text": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "type": {
            "enum": [
              "fasting",
              "timing",
              "diet",
              "hold_medicine",
              "collection",
              "bring_documents",
              "other"
            ]
          },
          "amount": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "range": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "applies_to": {
            "anyOf": [
              {
                "enum": [
                  "all",
                  "unclear"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "instruction": {
            "enum": [
              "fasting",
              "timing",
              "diet",
              "hold_medicine",
              "collection",
              "bring_documents",
              "other",
              "after_food"
            ]
          },
          "problems": {
            "type": "array",
            "items": {
              "enum": [
                "number-unclear",
                "number-implausible"
              ]
            }
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "status": {
              "const": "needs_check"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "preparation_phrases_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_rules_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "role",
          "name",
          "version"
        ],
        "properties": {
          "stage": {
            "enum": [
              "ingest",
              "ocr",
              "classify",
              "extract",
              "terminology",
              "validate",
              "project"
            ]
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "SW-S1: every engine, model and list that produced this result, by name and version, as each stage recorded it when it ran."
    },
    "review": {
      "type": "object",
      "required": [
        "needs_check_count",
        "items"
      ],
      "properties": {
        "needs_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "reason"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "absent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contract fields no extractor fills yet, so a reader can tell 'not extracted' from 'not on the page'."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Where on the page: the page number, the box, and the saved readings behind it."
    },
    "value": {
      "type": "object",
      "required": [
        "value",
        "status",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "accepted",
            "needs_check"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "corrected_from": {
          "type": "object",
          "required": [
            "fact_id",
            "value",
            "observation_ids"
          ],
          "properties": {
            "fact_id": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "observation_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Present when a person corrected the value: the reading it replaced."
        }
      },
      "additionalProperties": false,
      "description": "A read value with its trust status. 'accepted' only with a governed gate state and recorded evidence; anything else is 'needs_check' and carries a reason.",
      "if": {
        "properties": {
          "status": {
            "const": "needs_check"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
