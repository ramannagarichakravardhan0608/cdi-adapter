{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:result.v1",
  "title": "Prescription result (Output Contract, result.v1)",
  "description": "One document per prescription, shown by the upload screen and downloadable as a file (backlog UP-S3, the contract of OUT-S2). Every clinical value is a {value, status, confidence, evidence} object: a value never appears without its status, and 'accepted' requires both a governed gate state and recorded evidence. Fields the extractors do not produce yet are listed in 'absent' instead of being emitted empty - the contract marks them NEW (OUT-S1, EX-S1/S2/S4/S5). The field names are the Output Contract's own and are provisional until OUT-S2's open question (which system reads the JSON) is answered; 'schema_version' is what a consumer pins.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "received_at",
    "source",
    "page_count",
    "status",
    "review",
    "absent"
  ],
  "properties": {
    "schema_version": {"const": "result.v1"},
    "document_id": {"type": "string", "format": "uuid"},
    "received_at": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "page_count": {"type": "integer", "minimum": 0},
    "status": {"enum": ["complete", "needs_check", "held_for_rescan"]},
    "quality": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "channel": {"type": "string"},
            "drive": {"type": ["string", "null"]},
            "folder": {"type": ["string", "null"]},
            "file_name": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "patient": {
      "type": "object",
      "properties": {
        "name": {"$ref": "#/$defs/value"},
        "sex": {"$ref": "#/$defs/value"},
        "dob": {"$ref": "#/$defs/value"},
        "age_text": {"$ref": "#/$defs/value"},
        "ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {"type": {"type": "string"}, "value": {"type": "string"}}
          }
        }
      },
      "additionalProperties": true
    },
    "doctor": {
      "type": "object",
      "properties": {
        "name": {"$ref": "#/$defs/value"},
        "registration_no": {"$ref": "#/$defs/value"},
        "department": {"$ref": "#/$defs/value"},
        "link": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": {"type": "string"},
            "confidence": {"type": ["number", "null"]},
            "practitioner_id": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "visit": {
      "type": "object",
      "properties": {
        "encounter_date": {"$ref": "#/$defs/value"},
        "follow_up_date": {"$ref": "#/$defs/value"}
      },
      "additionalProperties": true
    },
    "lab_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["as_written", "value"],
        "properties": {
          "as_written": {"type": ["string", "number", "null"]},
          "kind": {"enum": ["test", "panel"]},
          "value": {"$ref": "#/$defs/value"},
          "result": {"$ref": "#/$defs/value"},
          "unit": {"type": ["string", "null"]},
          "standard": {
            "type": "object",
            "properties": {
              "name": {"type": ["string", "null"]},
              "code_system": {"type": ["string", "null"]},
              "code": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw_text", "value"],
        "properties": {
          "raw_text": {"type": ["string", "number", "null"]},
          "canonical_term": {"type": ["string", "null"]},
          "value": {"$ref": "#/$defs/value"},
          "external_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["system", "code"],
              "properties": {"system": {"type": "string"}, "code": {"type": "string"}}
            }
          }
        },
        "additionalProperties": true
      }
    },
    "preparation": {"type": "array", "items": {"type": "object"}},
    "review": {
      "type": "object",
      "required": ["needs_check_count", "items"],
      "properties": {
        "needs_check_count": {"type": "integer", "minimum": 0},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"value": {}, "reason": {"type": ["string", "null"]}}
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {"type": "object"},
    "absent": {
      "type": "array",
      "description": "Contract fields no extractor fills yet, so a reader can tell 'not extracted' from 'not on the page'.",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "value": {
      "type": "object",
      "description": "A read value with its trust status. 'accepted' only with a governed gate state and recorded evidence; anything else is 'needs_check' and carries a reason.",
      "required": ["value", "status", "confidence"],
      "properties": {
        "value": {},
        "status": {"enum": ["accepted", "needs_check"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reason": {"type": ["string", "null"]},
        "evidence": {
          "type": "object",
          "properties": {
            "page": {"type": ["integer", "null"]},
            "bbox": {"type": ["array", "null"], "items": {"type": "number"}},
            "observation_ids": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
