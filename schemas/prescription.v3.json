{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:prescription.v3",
  "title": "Prescription extraction (v3, relaxed)",
  "type": "object",
  "properties": {
    "patient": {"$ref": "cdi:common.defs#/$defs/patient"},
    "encounter_date": {"$ref": "cdi:common.defs#/$defs/date_text"},
    "prescriber": {"type": ["string", "null"]},
    "prescriber_details": {
      "description": "the doctor who wrote it, exactly as the page gives it; every field optional, null when not on the page",
      "type": ["object", "null"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "registration_no": {"type": ["string", "null"], "description": "the medical council registration number, digit for digit"},
        "qualification": {"type": ["string", "null"]},
        "department": {"type": ["string", "null"], "description": "department or speciality"},
        "clinic": {
          "type": ["object", "null"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "address": {"type": ["string", "null"]},
            "phone": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "stamp_present": {"type": ["boolean", "null"], "description": "true when a rubber stamp or seal is on the page"},
        "signature_present": {"type": ["boolean", "null"], "description": "true when a handwritten signature is on the page"},
        "stamp_text": {"type": ["string", "null"], "description": "the text inside the stamp or seal, kept apart from the letterhead"},
        "evidence": {"$ref": "cdi:common.defs#/$defs/evidence"}
      },
      "additionalProperties": true
    },
    "diagnoses": {"$ref": "cdi:common.defs#/$defs/coded_list"},
    "medications": {"$ref": "cdi:common.defs#/$defs/medication_list"},
    "vitals": {"$ref": "cdi:common.defs#/$defs/vital_list"},
    "allergies": {"$ref": "cdi:common.defs#/$defs/allergy_list"},
    "advice": {"$ref": "cdi:common.defs#/$defs/text_list"},
    "investigations_advised": {"$ref": "cdi:common.defs#/$defs/text_list", "description": "tests the doctor advises or orders (Investigations / Adv / Ix), one per test, as written"},
    "investigation_preparation": {
      "description": "what the patient must do before a test, ONLY as written (fasting 12 hrs, morning sample, stop biotin, bring previous reports); empty when none is written - never a usual rule",
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "description": "the original words"},
          "type": {"type": ["string", "null"], "enum": ["fasting", "timing", "diet", "hold_medicine", "collection", "bring_documents", "other", null]},
          "value": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]},
          "applies_to": {"type": ["array", "null"], "items": {"type": "string"}},
          "evidence": {"$ref": "cdi:common.defs#/$defs/evidence"},
          "confidence": {"$ref": "cdi:common.defs#/$defs/confidence"}
        },
        "required": ["text"],
        "additionalProperties": true
      }
    },
    "confidence": {"$ref": "cdi:common.defs#/$defs/confidence"}
  },
  "required": ["medications", "confidence"],
  "additionalProperties": false
}
