# The file listener pointed at OneDrive (backlog LS-S1).
#
# This file and its twin differ ONLY in the drive settings below: switching drives is a change of
# settings, never of code. Copy the lines into .env (or load this file) and run
#
#     python -m cdi_adapter.listener check
#
# which signs in, finds the six folders (creating any that are missing) and says how many files
# are waiting. It processes nothing.
#
# NO SECRET BELONGS IN THIS FILE: nothing here is a password, a key or a token. Sign in once
# with `python -m cdi_adapter.listener login` (docs/LISTENER.md, "Signing in").

# the same on every drive: what the six folders are called
CDI_LISTENER_INBOX=inbox
CDI_LISTENER_PROCESSING=processing
CDI_LISTENER_SUCCESS=success
CDI_LISTENER_ERROR=error
CDI_LISTENER_QUARANTINE=quarantine
CDI_LISTENER_LOG=log
CDI_LISTENER_MAX_WAIT_SECONDS=300

# ---- the only part that differs between drives ----
CDI_LISTENER_CONNECTOR=onedrive
# the folder's path inside the drive ("" = the drive's root)
CDI_LISTENER_ROOT=Prescriptions/Incoming
# leave all three empty for the signed-in person's own OneDrive (/me/drive)
CDI_GRAPH_DRIVE_ID=
CDI_GRAPH_USER=
# for SharePoint instead: CDI_LISTENER_CONNECTOR=sharepoint and CDI_GRAPH_SITE_ID=<site id>
CDI_GRAPH_SITE_ID=
# signing in (LS-S2): the Entra app registration, and "device" (a person types a code on
# Microsoft's page, once) or "app" (a service identity an administrator approved)
CDI_GRAPH_AUTH=device
CDI_GRAPH_CLIENT_ID=
CDI_GRAPH_TENANT_ID=
# the renewable sign-in is kept on the persistent disk, by default in
# /workspace/.cdi/graph_token_cache.json (see docs/LISTENER.md to move it)
